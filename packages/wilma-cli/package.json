{
  "name": "@wilm-ai/wilma-cli",
  "version": "2.1.0",
  "description": "Read your children's Wilma (Finnish school system) from the terminal or an AI assistant: schedule, homework, exams, messages and news.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aikarjal/wilmai.git",
    "directory": "packages/wilma-cli"
  },
  "homepage": "https://wilm.ai",
  "bugs": "https://github.com/aikarjal/wilmai/issues",
  "engines": {
    "node": ">=20.18.1"
  },
  "type": "module",
  "bin": {
    "wilmai": "dist/index.js",
    "wilma": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @wilm-ai/wilma-client build && pnpm run build && node test/news-resources.mjs && node test/mcp-login.mjs && node test/mfa.mjs && node test/audit.mjs && node test/update-notice.mjs",
    "start": "node dist/index.js",
    "prepack": "pnpm --filter @wilm-ai/wilma-client build && pnpm --filter @wilm-ai/wilma-cli build",
    "test:live": "tsc -p tsconfig.json && node test/live.spec.mjs",
    "build:mcpb": "pnpm run build && node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^5.3.8",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@wilm-ai/wilma-client": "^1.6.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
